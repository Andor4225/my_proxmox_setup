# Copy to .env and fill in real values. .env is gitignored — NEVER commit it.
#
# Required by the MCP server (src/index.ts + src/proxmox-client.ts):

# Proxmox host and API port
PROXMOX_HOST=192.168.10.147
PROXMOX_PORT=8006

# API token: "<user>@<realm>!<tokenname>" and its secret UUID.
# Mint with: pveum user token add <user@realm> <tokenname>
PROXMOX_TOKEN_ID=root@pam!your-token-name
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# The Proxmox host uses a self-signed cert. Set to "false" to skip TLS
# verification (or set NODE_TLS_REJECT_UNAUTHORIZED=0 in the MCP env).
PROXMOX_VERIFY_SSL=false

# NOTE: the real .env on the host may also carry secrets for other subsystems
# (e.g. a Cloudflare Tunnel token). Those are not required by this repo's code
# and must never be committed.
